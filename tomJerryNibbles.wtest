import tomJerryNibbles.*

describe "Grupo de test" {

  test "test 1" {
  //Al inicio, la velocidad máxima de Tom es 10 (su energía es 50)
    assert.equals(50, tom.energia())
    assert.equals(10, tom.velocidadMaxima())
    
  }
  
  test "test 2" {
  //Si come a Jerry, la velocidad máxima pasa a ser  15.2 (su energía es 102)
    tom.comerUnRaton(jerry)

    assert.equals(15.2, tom.velocidadMaxima())
    assert.equals(102, tom.energia())
  }

  test "test 3" {
  //Si corre 24 metros, entonces su velocidad máxima pasa a ser 14 (su energía es 90)
    tom.comerUnRaton(jerry)
    tom.correrTanta(24)

    assert.equals(14, tom.velocidadMaxima())
    assert.equals(90, tom.energia())
  }

  test "test 4" {
  //Si come a Nibbles, pasa a tener de velocidad máxima 18.7 (su energía es 137)
    tom.comerUnRaton(jerry)
    tom.correrTanta(24)
    tom.comerUnRaton(nibbles)

    assert.equals(18.7, tom.velocidadMaxima())
    assert.equals(137, tom.energia())
  }
  

  test "test 5" {
  //Si Jerry cumple años (3 años de edad), y luego Tom lo vuelve a comer, pasaría a tener 25.9 (su energia es 209)  
    tom.comerUnRaton(jerry)
    tom.correrTanta(24)
    tom.comerUnRaton(nibbles)
    jerry.cumplirAños()
    tom.comerUnRaton(jerry)

    assert.equals(25.9, tom.velocidadMaxima())
    assert.equals(209, tom.energia())
  }

  test "test 6" {
  //Si corre 38 metros su velocidad pasa a ser 24 (su energia es 190)
    tom.comerUnRaton(jerry)
    tom.correrTanta(24)
    tom.comerUnRaton(nibbles)
    jerry.cumplirAños()
    tom.comerUnRaton(jerry)
    tom.correrTanta(38)

    assert.equals(24, tom.velocidadMaxima())
    assert.equals(190, tom.energia())
  }
} 

test "test 6" {
  //Jerry tiene 50 de energia,puede cazar a Jerry a 38 metros de distancia, pero no cuando esta a 80 metros de distancia

    assert.that(tom.puedeCazar_ACierta_(jerry, 38))
    assert.notThat(tom.puedeCazar_ACierta_(jerry, 80))
}

test "test 7"{
  //Tom puede cazar a 50 metros, pero no a 105 metros después de comerse a Jerry (tiene 102 de energia)
    tom.comerUnRaton(jerry)
  
    assert.equals(102, tom.energia())
    assert.that(tom.puedeCazar_ACierta_(jerry, 50))
    assert.notThat(tom.puedeCazar_ACierta_(nibbles, 105))

}

